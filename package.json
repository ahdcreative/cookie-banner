{
  "name": "@ahdcreative/cookie-banner",
  "version": "1.1.1",
  "description": "🍪 👮 EU Cookie Law Plugin for Vue",
  "license": "MIT",
  "author": {
    "name": "AHD Creative",
    "email": "hello@ahd-creative.agency",
    "url": "https://ahd-creative.agency"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ahdcreative/cookie-banner.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "check": "biome check",
    "fix": "biome check --write",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "test": "vitest",
    "validate": "npm run check && npm run test run && npm run build",
    "type-check": "tsc -b"
  },
  "dependencies": {
    "vue": "^3.5.28"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.6.1",
    "jsdom": "^24.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.21",
    "vitest": "^2.0.0",
    "vue-tsc": "^3.2.4"
  },
  "exports": {
    ".": {
      "types": "./dist/vue-cookie-law.d.ts",
      "import": "./dist/vue-cookie-law.js",
      "require": "./dist/vue-cookie-law.umd.cjs"
    }
  },
  "main": "./dist/vue-cookie-law.umd.cjs",
  "module": "./dist/vue-cookie-law.js",
  "types": "./dist/vue-cookie-law.d.ts",
  "files": [
    "dist"
  ]
}
